{
  "_meta": {
    "name": "nexus-combat-tuning",
    "version": 1,
    "date": "2026-11-13",
    "status": "PROPOSED - belum dipakai kode, menunggu T2 selesai",
    "source": "turunan Ikemen GO v1.0.0 (MIT) + docs/13; angka Ikemen = acuan rasa, bukan salinan mentah",
    "rule": "semua nilai masuk config/data, jangan hardcode di sistem Quantum"
  },
  "tickRate": 60,
  "input": {
    "commandWindowTicks": 15,
    "bufferButtonsTicks": 4,
    "bufferGestureTicks": 6,
    "stepWindowTicks": 6,
    "freezeBufferDuringHitStop": true,
    "maxExtraTicksDuringHitStop": 1
  },
  "hitPauseByWeight": {
    "attackerAndVictim": { "light": [6, 6], "medium": [9, 9], "heavy": [12, 12], "launcher": [12, 14], "super": [16, 18] },
    "guard": [7, 7],
    "counterHitBonus": 2
  },
  "hitStun": {
    "ground": { "light": 11, "medium": 14, "heavy": 17 },
    "air": { "light": 12, "medium": 15, "heavy": 18 },
    "minimumTicks": 10,
    "slideTime": { "light": 5, "medium": 8, "heavy": 10 },
    "downRecoverTicks": 40,
    "getupInvulnTicks": 10
  },
  "knockback": {
    "_note": "fixed-point, satuan unit FP/dtick, lokal terhadap yaw penyerang",
    "light": { "forward": -1024, "up": 0 },
    "heavy": { "forward": -1536, "up": -256 },
    "launcher": { "forward": -512, "up": -2304 },
    "wallHit": { "enabled": true, "minSpeed": 2048, "damage": 40, "stun": 14, "juggleCost": 2 },
    "groundBounce": { "enabled": true, "minFallSpeed": 1536, "bounceVel": -768, "damage": 20 }
  },
  "cornerPush": {
    "attackerPushMul": 1.0,
    "guardPushMul": 1.3,
    "_source": "Ikemen: ground_cornerpush_veloff = velocity[0]; guard = guard_velocity[0] * 1.3"
  },
  "guard": {
    "arcDegrees": 180,
    "lockFacing": true,
    "gaugeMax": 100,
    "drainMul": 1.0,
    "drainByWeight": { "light": 5, "medium": 10, "heavy": 18, "launcher": 22 },
    "regenPerTick": 6,
    "regenDelayTicks": 30,
    "crushDurationTicks": 45,
    "gaugeAfterCrush": 35,
    "chipDamageMul": 0.10,
    "chipCanKill": false
  },
  "armor": {
    "super": { "absorbHitStun": true, "breakOnDamageFraction": 0.25, "breakOnHitsInWindow": 3, "windowTicks": 20 },
    "hyper": { "absorbAllReactions": true, "maxDurationTicks": 30 }
  },
  "counterHit": {
    "enabled": true,
    "damageMul": 1.15,
    "hitStunBonus": 4,
    "juggleCostReduction": 1,
    "applyToProjectiles": false
  },
  "juggle": {
    "model": "singlePoolOnVictim",
    "note": "S1 docs/08: budget milik korban, tidak reset saat penyerang swap. Ikemen pakai per-attacker; sengaja berbeda.",
    "maxBudget": 12,
    "costByWeight": { "light": 1, "medium": 2, "heavy": 3, "launcher": 5, "super": 6 },
    "resetOnGroundRecover": true
  },
  "combo": {
    "maxChain": 4,
    "scalingPerHit": [1.0, 0.9, 0.8, 0.7, 0.6, 0.5],
    "scalingMin": 0.4,
    "resetAfterHitStunGapTicks": 6
  },
  "juice": {
    "shake": { "amplitude": -4, "frequency": 60, "decayPerTick": 0.9, "maxOffset": 12 },
    "spark": { "contactPoint": true, "guardDifferentColor": true, "scaleByPower": true },
    "flash": { "victimFlashTicks": 2, "flashAlpha": 0.6 },
    "audioLayers": ["whoosh", "impact", "guard", "voice", "announcer"],
    "voiceMinHitPauseTicks": 12
  },
  "superFreeze": {
    "ticks": 30,
    "moveTicks": 8,
    "darken": 0.5,
    "defenseMulTarget": 0.8,
    "invulnerableDuringFreeze": true
  },
  "koSlowMotion": {
    "_source": "Ikemen defaults: slow_time=60, slow_fadetime=0.75*time, slow_speed=0.25",
    "totalTicks": 60,
    "fadeTicks": 45,
    "speed": 0.25,
    "onlyOnFinalKO": true,
    "mustBeDeterministic": true
  },
  "swap": {
    "heroesPerMatch": 3,
    "hpModel": "sharedPerPlayer",
    "neutralCooldownTicks": 180,
    "defensiveCooldownTicks": 720,
    "swapOutStateTicks": 18,
    "swapInInvulnTicks": 10,
    "lockedDuringCritical": true
  }
}
